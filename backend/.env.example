# App
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Hosting: the operator token is required for every mutating endpoint. Allowed origins are comma-separated.
PATCHLANE_OPERATOR_TOKEN=
PATCHLANE_ALLOWED_ORIGINS=http://localhost:5173

# Daytona (app.daytona.io -> API keys)
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=patchlane-bank-service

# Factory (app.factory.ai/settings/api-keys). The droid CLI must also be installed.
FACTORY_API_KEY=
DROID_MODEL=

# Chalk: credentials come from `chalk login` (~/.chalk.yml), not this file.
